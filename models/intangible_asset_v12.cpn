      pid0,
      orderAssetID,
      orderSupplierID,
      orderMode
    ) =
    ord

  val
    (
      voucherID,
      voucherOrderID,
      voucherAssetID,
      voucherInvoiceID
    ) =
    voucher

  val
    (
      invoiceID,
      invoiceOrderID,
      invoiceSupplierID
    ) =
    inv

  val
    (
      assetID,
      assetCategory
    ) =
    asset

  val accountantID =
    #resourceID assetAccountant

  val relationshipsMatch =
       orderID = oid
    andalso voucherOrderID = oid
    andalso invoiceOrderID = oid
    andalso orderAssetID = aid
    andalso voucherAssetID = aid
    andalso assetID = aid
    andalso voucherInvoiceID = invoiceID
    andalso orderSupplierID = invoiceSupplierID

  val _ =
    if relationshipsMatch
    then
      ()
    else
      raise Fail
        &quot;Post accounting voucher: object identifiers do not match&quot;
in
  ocelLogEventAt
    (
      &quot;Post Accounting Voucher&quot;,
      &quot;PostAccountingVoucher&quot;,
      ocelTimeAfter
        (D_POST_ACCOUNTING_VOUCHER),
      &quot;&quot;,
      [
        (orderID, &quot;posted order&quot;),
        (rid0, &quot;source requirement&quot;),
        (pid0, &quot;project context&quot;),
        (aid, &quot;capitalized asset&quot;),
        (orderSupplierID, &quot;supplier&quot;),
        (voucherID, &quot;posted voucher&quot;),
        (invoiceID, &quot;posted invoice&quot;),
        (accid, &quot;archived acceptance record&quot;),
        (accountantID, &quot;performed by&quot;)
      ]
    )
end</text>
        </code>
