        <ml id="ID2147406293">val MINUTES_PER_HOUR : int = 60;
val MINUTES_PER_DAY : int = 24 * MINUTES_PER_HOUR;

val WORK_START_MINUTE : int = 9 * MINUTES_PER_HOUR;
val WORK_END_MINUTE : int = 17 * MINUTES_PER_HOUR;
val WORK_MINUTES_PER_DAY : int = 8 * MINUTES_PER_HOUR;

(* Model time 0 starts at Monday 09:00. *)
val MODEL_START_MINUTE_OF_WEEK : int = 9 * MINUTES_PER_HOUR;
          <layout>(* ====================================================== *)
(* BUSINESS CALENDAR                                      *)
(* 1 model time unit = 1 actual minute                    *)
(* Model time 0 = Monday 2026-01-05 09:00 UTC             *)
(* Working time = Monday-Friday, 09:00-17:00              *)
(* ====================================================== *)

val MINUTES_PER_HOUR : int = 60;
val MINUTES_PER_DAY : int = 24 * MINUTES_PER_HOUR;

val WORK_START_MINUTE : int = 9 * MINUTES_PER_HOUR;
val WORK_END_MINUTE : int = 17 * MINUTES_PER_HOUR;
val WORK_MINUTES_PER_DAY : int = 8 * MINUTES_PER_HOUR;

(* Model time 0 starts at Monday 09:00. *)
val MODEL_START_MINUTE_OF_WEEK : int = 9 * MINUTES_PER_HOUR;</layout>
        </ml>
