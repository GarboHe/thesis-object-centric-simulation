  ocelWriteFile
    (
      &quot;event_TerminateAfterContractRejection.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_CreatePurchaseOrder.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_ReceiveContractDeliverable.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_ReceiveInvoice.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_PerformBusinessAndTechnicalAcceptance.csv&quot;,
      &quot;ocel_id;ocel_time;decision\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_VerifyAccountingPrerequisites.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_ConfirmAccountingDate.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_CreateOrUpdateIntangibleAssetRecord.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_CreateAccountingVoucher.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_ReviewAccountingVoucher.csv&quot;,
      &quot;ocel_id;ocel_time;decision\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_ModifyAccountingVoucher.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
    (
      &quot;event_PostAccountingVoucher.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

 ocelWriteFile
  (
    &quot;event_AssignAssetToProject.csv&quot;,
    &quot;ocel_id;ocel_time;project_id\n&quot;
  );
  ocelWriteFile
    (
      &quot;event_RectifyAndRedeliver.csv&quot;,
      &quot;ocel_id;ocel_time\n&quot;
    );

  ocelWriteFile
  (
    &quot;event_PutAssetIntoUse.csv&quot;,
    &quot;ocel_id;ocel_time;project_id\n&quot;
  );


  (* Object-specific files *)

  ocelWriteFile
    (
      &quot;object_Project.csv&quot;,

      &quot;ocel_id;ocel_time;&quot; ^
      &quot;ocel_changed_field;&quot; ^
      &quot;planned_req_count\n&quot;
    );

  ocelWriteFile
    (
      &quot;object_Requirement.csv&quot;,

      &quot;ocel_id;ocel_time;&quot; ^
      &quot;ocel_changed_field;&quot; ^
      &quot;demand_source\n&quot;
    );

  ocelWriteFile
    (
      &quot;object_Asset.csv&quot;,

      &quot;ocel_id;ocel_time;&quot; ^
      &quot;ocel_changed_field;&quot; ^
      &quot;category\n&quot;
    );

  ocelWriteFile
    (
      &quot;object_Supplier.csv&quot;,

      &quot;ocel_id;ocel_time;&quot; ^
      &quot;ocel_changed_field\n&quot;
    );

  ocelWriteFile
    (
      &quot;object_Order.csv&quot;,

      &quot;ocel_id;ocel_time;&quot; ^
      &quot;ocel_changed_field;&quot; ^
      &quot;contract_mode\n&quot;
    );

  ocelWriteFile
    (
      &quot;object_Invoice.csv&quot;,
      &quot;ocel_id;ocel_time;ocel_changed_field\n&quot;
    );

  ocelWriteFile
    (
      &quot;object_AcceptanceRecord.csv&quot;,
      &quot;ocel_id;ocel_time;ocel_changed_field\n&quot;
    );

  ocelWriteFile
    (
      &quot;object_Voucher.csv&quot;,
      &quot;ocel_id;ocel_time;ocel_changed_field\n&quot;
    );
ocelWriteFile
  (
    &quot;object_Resource.csv&quot;,

    &quot;ocel_id;ocel_time;&quot; ^
    &quot;ocel_changed_field;&quot; ^
    &quot;role\n&quot;
  );


  (* Suppliers already exist at simulation start *)

  List.app
    (
      fn supplier =&gt;
        ocelRegisterSupplier
          (#sid supplier)
    )
    AllSuppliers
);</layout>
        </ml>
        <ml id="ID-2147480803">fun ocelRegisterResource
    (
      resourceID : string,
      resourceRole : ResourceRole
    ) =
  if ocelRegisterObjectBase
       (
         resourceID,
         &quot;Resource&quot;
       )
  then
    ocelAppendLine
      (
        &quot;object_Resource.csv&quot;,

        resourceID ^ &quot;;&quot; ^
        ocelTimestampFromElapsedMinute(0) ^
        &quot;;;&quot; ^
        ocelResourceRoleText(resourceRole)
      )
  else
    ();
          <layout>fun ocelRegisterResource
    (
      resourceID : string,
      resourceRole : ResourceRole
    ) =
  if ocelRegisterObjectBase
       (
         resourceID,
         &quot;Resource&quot;
       )
  then
    ocelAppendLine
      (
        &quot;object_Resource.csv&quot;,

        resourceID ^ &quot;;&quot; ^
        ocelTimestampFromElapsedMinute(0) ^
        &quot;;;&quot; ^
        ocelResourceRoleText(resourceRole)
      )
  else
    ();</layout>
        </ml>
        <ml id="ID-2147477804">fun ocelRegisterInitialResources () =
  List.app
    ocelRegisterResource
    [
      (
        &quot;RR-1&quot;,
        REQUIREMENT_REVIEWER
      ),

      (
        &quot;PO-1&quot;,
        PROCUREMENT_OFFICER
      ),

      (
        &quot;PO-2&quot;,
        PROCUREMENT_OFFICER
      ),

      (
        &quot;CR-1&quot;,
        CONTRACT_REVIEWER
      ),

      (
        &quot;AT-1&quot;,
        ACCEPTANCE_TEAM
      ),

      (
        &quot;AA-1&quot;,
        ASSET_ACCOUNTANT
      ),

      (
        &quot;VR-1&quot;,
        VOUCHER_REVIEWER
      )
    ];
