      <trans id="ID2147311945"
             explicit="false">
        <posattr x="223.062500"
                 y="-30.406250"/>
        <fillattr colour="White"
                  pattern=""
                  filled="false"/>
        <lineattr colour="Black"
                  thick="1"
                  type="solid"/>
        <textattr colour="Black"
                  bold="false"/>
        <text>generate 
requirement&amp; asset</text>
        <box w="138.000000"
             h="50.000000"/>
        <binding x="7.200000"
                 y="-3.000000"/>
        <cond id="ID2147311946">
          <posattr x="308.875000"
                   y="32.187500"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">[#pid project = #pid arrival
 andalso
 nextID &lt;= #plannedReqCount project]</text>
        </cond>
        <time id="ID2147311947">
          <posattr x="306.562500"
                   y="5.593750"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1"/>
        </time>
        <code id="ID2147311948">
          <posattr x="-99.500000"
                   y="-945.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">input (project, nextID, arrival);
output (reqOut, assetOut);
action
let
  val generatedRequirement =
    makeRequirement
      (
        #pid arrival,
        nextID
      )

  val generatedAsset =
    makeAsset(nextID)

  (* Requirement  Asset  *)
  val creationTime =
    ocelCurrentTimeText()

  val
    (
      rid0,
      pid0,
      aidFromRequirement
    ) =
    generatedRequirement

  val
    (
      aidFromAsset,
      category0
    ) =
    generatedAsset

  val _ =
    if #pid project = pid0
    then
      ()
    else
      raise Fail
        &quot;Generator error: project IDs do not match&quot;

  val _ =
    if aidFromRequirement = aidFromAsset
    then
      ()
    else
      raise Fail
        &quot;Generator error: Requirement and Asset IDs do not match&quot;

  (* Register Project as existing master/context object *)
  val _ =
    ocelRegisterProject
      (
        pid0,
        #plannedReqCount project
      )

  (* Register Requirement at its actual generation time *)
  val _ =
    ocelRegisterRequirementAt
      (
        rid0,
        #source arrival,
        creationTime
      )

  (* Register Asset at the same generation time *)
  val _ =
    ocelRegisterAssetAt
      (
        aidFromAsset,
        category0,
        creationTime
      )

  (* Project -&gt; Requirement *)
  val _ =
    ocelRegisterO2O
      (
        pid0,
        rid0,
        &quot;raises requirement&quot;
      )

  (* Requirement -&gt; Asset *)
  val _ =
    ocelRegisterO2O
      (
        rid0,
        aidFromAsset,
        &quot;requests asset&quot;
      )
in
  (
    generatedRequirement,
    generatedAsset
  )
end</text>
