  1767603600;

val SECONDS_PER_MODEL_UNIT : LargeInt.int =
  60;
          <layout>(* 2026-01-05T09:00:00Z *)
val SIMULATION_START_UNIX : LargeInt.int =
  1767603600;

val SECONDS_PER_MODEL_UNIT : LargeInt.int =
  60;</layout>
