        <ml id="ID2147380504">fun sampleNextDemandSource BACKGROUND =
let
  val draw =
    discrete(1, 100)
in
  if draw &lt;= 75 then
    BACKGROUND
  else if draw &lt;= 87 then
    NEW_CUSTOMER_ORDER
  else if draw &lt;= 95 then
    NEW_PRODUCTION_LINE
  else
    NEW_CUSTOMER_REQUIREMENT
end

  | sampleNextDemandSource NEW_CUSTOMER_ORDER =
      if discrete(1, 100) &lt;= 60
      then NEW_CUSTOMER_ORDER
      else BACKGROUND

  | sampleNextDemandSource NEW_PRODUCTION_LINE =
      if discrete(1, 100) &lt;= 75
      then NEW_PRODUCTION_LINE
      else BACKGROUND

  | sampleNextDemandSource NEW_CUSTOMER_REQUIREMENT =
      if discrete(1, 100) &lt;= 50
      then NEW_CUSTOMER_REQUIREMENT
      else BACKGROUND;
