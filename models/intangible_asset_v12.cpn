        <box w="120.000000"
             h="66.000000"/>
        <binding x="7.200000"
                 y="-3.000000"/>
        <cond id="ID2147311940">
          <posattr x="-783.000000"
                   y="183.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
