(* ---------- O2O relationship writer ---------- *)

fun ocelRegisterO2O
    (sourceID : string,
     targetID : string,
     qualifier : string) =
let
  val relationKey =
    sourceID ^ &quot;|&quot; ^
    targetID ^ &quot;|&quot; ^
    qualifier
in
  if ocelContainsString
       (relationKey,
        !ocelSeenO2ORelations)
  then
    ()
  else
  (
    ocelSeenO2ORelations :=
      relationKey ::
      (!ocelSeenO2ORelations);

    ocelAppendLine
      (
        &quot;object_object.csv&quot;,
        sourceID ^ &quot;;&quot; ^
        targetID ^ &quot;;&quot; ^
        qualifier
      )
  )
end;


(* ---------- Event and E2O writer ---------- *)

fun ocelLogEventAt
    (
      eventType : string,
      eventTypeMap : string,
      eventTime : string,
      extraFields : string,
      objectLinks :
        (string * string) list
    ) =
let
  val eventID =
    ocelNextEventID()

  val eventSequence =
    !ocelEventCounter
in
  (* Standard general event table *)
  ocelAppendLine
    (
      &quot;event.csv&quot;,
      eventID ^ &quot;;&quot; ^ eventType
    );

  ocelAppendLine
    (
      &quot;event_&quot; ^
      eventTypeMap ^
      &quot;.csv&quot;,

      eventID ^ &quot;;&quot; ^
      eventTime ^
      extraFields
    );

  ocelAppendLine
  (
    &quot;event_all.csv&quot;,

    eventID ^ &quot;;&quot; ^
    eventType ^ &quot;;&quot; ^
    eventTime ^ &quot;;&quot; ^
    Int.toString(eventSequence)
  );

  List.app
    (
      fn (objectID, qualifier) =&gt;
        ocelAppendLine
          (
            &quot;event_object.csv&quot;,
            eventID ^ &quot;;&quot; ^
            objectID ^ &quot;;&quot; ^
            qualifier
          )
    )
    objectLinks
end;


(* ---------- Initialize all OCEL CSV files ---------- *)

fun ocelInit () =
(
  ocelEventCounter := 0;
  ocelSeenObjects := [];
  ocelSeenO2ORelations := [];


  (* General tables *)

  ocelWriteFile
    (
      &quot;event.csv&quot;,
      &quot;ocel_id;ocel_type\n&quot;
    );

  ocelWriteFile
    (
      &quot;object.csv&quot;,
      &quot;ocel_id;ocel_type\n&quot;
