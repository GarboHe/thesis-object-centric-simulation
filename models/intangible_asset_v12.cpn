          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">input (oid, rid, pid, aid, sid, invid, accid, assetAccountant);
output ();
action
let
  val voucherID =
    &quot;V-&quot; ^ oid

  val accountantID =
    #resourceID assetAccountant

  val completionTime =
    ocelTimeAfter
      (D_CREATE_ACCOUNTING_VOUCHER)

  val _ =
    ocelRegisterVoucherAt
      (
        voucherID,
        completionTime
      )

  val _ =
    ocelRegisterO2O
      (
        voucherID,
        oid,
        &quot;created for order&quot;
      )

  val _ =
    ocelRegisterO2O
      (
        voucherID,
        aid,
        &quot;capitalizes asset&quot;
      )

  val _ =
    ocelRegisterO2O
      (
        voucherID,
        invid,
        &quot;based on invoice&quot;
      )

  val _ =
    ocelRegisterO2O
      (
        voucherID,
        accid,
        &quot;based on acceptance record&quot;
      )
in
  ocelLogEventAt
    (
      &quot;Create Accounting Voucher&quot;,
      &quot;CreateAccountingVoucher&quot;,
      completionTime,
      &quot;&quot;,
      [
        (voucherID, &quot;created voucher&quot;),
        (oid, &quot;related order&quot;),
        (rid, &quot;source requirement&quot;),
        (pid, &quot;project context&quot;),
        (aid, &quot;capitalized asset&quot;),
        (sid, &quot;supplier&quot;),
        (invid, &quot;related invoice&quot;),
        (accid, &quot;related acceptance record&quot;),
        (accountantID, &quot;performed by&quot;)
      ]
    )
end</text>
