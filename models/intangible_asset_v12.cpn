          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">@+ businessElapsedDelay(D_CREATE_PURCHASE_ORDER)</text>
        </time>
        <code id="ID1164">
          <posattr x="1686.000000"
                   y="-1249.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">input (i, rid, pid, aid, quote, mode, procurementOfficer);
output ();
action
let
  val orderID =
    &quot;O-&quot; ^ Int.toString(i)

  val supplierID =
    #sid quote

  val officerID =
    #resourceID procurementOfficer

  val completionTime =
    ocelTimeAfter(D_CREATE_PURCHASE_ORDER)

  val _ =
    ocelRegisterOrderAt
      (
        orderID,
        mode,
        completionTime
      )

  val _ =
    ocelRegisterO2O
      (
        pid,
        orderID,
        &quot;contains order&quot;
      )

  val _ =
    ocelRegisterO2O
      (
        rid,
        orderID,
        &quot;results in order&quot;
      )

  val _ =
    ocelRegisterO2O
      (
        orderID,
        aid,
        &quot;orders asset&quot;
      )

  val _ =
    ocelRegisterO2O
      (
        orderID,
        supplierID,
        &quot;placed with supplier&quot;
      )
in
  ocelLogEventAt
    (
      &quot;Create Purchase Order&quot;,
      &quot;CreatePurchaseOrder&quot;,
      completionTime,
      &quot;&quot;,
      [
        (orderID, &quot;created order&quot;),
        (rid, &quot;source requirement&quot;),
        (pid, &quot;project context&quot;),
        (aid, &quot;ordered asset&quot;),
        (supplierID, &quot;selected supplier&quot;),
        (officerID, &quot;performed by&quot;)
      ]
    )
end</text>
