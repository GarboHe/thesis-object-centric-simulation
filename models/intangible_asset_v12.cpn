          <layout>fun ocelFilePath fileName =
    OCEL_DIR ^ fileName;


fun ocelWriteFile
    (fileName : string,
     content  : string) =
let
  val out =
    TextIO.openOut
      (ocelFilePath fileName)
in
  TextIO.output(out, content);
  TextIO.closeOut(out)
end;


fun ocelAppendLine
    (fileName : string,
     line     : string) =
let
  val out =
    TextIO.openAppend
      (ocelFilePath fileName)
in
  TextIO.output(out, line ^ &quot;\n&quot;);
  TextIO.closeOut(out)
end;


fun ocelContainsString
    (value : string,
     values : string list) =
  List.exists
    (fn current =&gt; current = value)
    values;


(* ---------- Value-to-string functions ---------- *)

fun ocelCategoryText CategoryA = &quot;CategoryA&quot;
  | ocelCategoryText CategoryB = &quot;CategoryB&quot;
  | ocelCategoryText CategoryC = &quot;CategoryC&quot;
  | ocelCategoryText CategoryD = &quot;CategoryD&quot;
  | ocelCategoryText CategoryE = &quot;CategoryE&quot;;


fun ocelReviewDecisionText APPROVED =
      &quot;APPROVED&quot;
  | ocelReviewDecisionText MODIFY =
      &quot;MODIFY&quot;
  | ocelReviewDecisionText REJECTED =
      &quot;REJECTED&quot;;


fun ocelContractDecisionText CONTRACT_APPROVED =
      &quot;CONTRACT_APPROVED&quot;
  | ocelContractDecisionText CONTRACT_MODIFY =
      &quot;CONTRACT_MODIFY&quot;
  | ocelContractDecisionText CONTRACT_REJECTED =
      &quot;CONTRACT_REJECTED&quot;;


fun ocelContractModeText Existing =
      &quot;Existing&quot;
  | ocelContractModeText New =
      &quot;New&quot;;


fun ocelDemandSourceText BACKGROUND =
      &quot;BACKGROUND&quot;
  | ocelDemandSourceText NEW_CUSTOMER_ORDER =
      &quot;NEW_CUSTOMER_ORDER&quot;
  | ocelDemandSourceText NEW_PRODUCTION_LINE =
      &quot;NEW_PRODUCTION_LINE&quot;
  | ocelDemandSourceText NEW_CUSTOMER_REQUIREMENT =
      &quot;NEW_CUSTOMER_REQUIREMENT&quot;;


fun ocelVoucherReviewDecisionText VOUCHER_APPROVED =
      &quot;VOUCHER_APPROVED&quot;
  | ocelVoucherReviewDecisionText VOUCHER_MODIFY =
      &quot;VOUCHER_MODIFY&quot;;


fun ocelAcceptanceDecisionText ACCEPTANCE_APPROVED =
      &quot;ACCEPTANCE_APPROVED&quot;
  | ocelAcceptanceDecisionText ACCEPTANCE_REWORK =
      &quot;ACCEPTANCE_REWORK&quot;
  | ocelAcceptanceDecisionText ACCEPTANCE_REJECTED =
      &quot;ACCEPTANCE_REJECTED&quot;;


fun ocelCurrentTimeText () =
  ocelTimestampFromElapsedMinute
    (
      currentModelMinute()
    );


fun ocelTimeAfter
    (workMinutes : int) =
let
  val actualDelay =
    businessElapsedDelay(workMinutes)
in
  ocelTimestampFromElapsedMinute
    (
      currentModelMinute()
      +
      actualDelay
    )
end;


(* ---------- Event identifiers ---------- *)

fun ocelNextEventID () =
(
  inc ocelEventCounter;
  &quot;e-&quot; ^ Int.toString(!ocelEventCounter)
);


(* ---------- Generic object registration ---------- *)

fun ocelRegisterObjectBase
    (objectID   : string,
     objectType : string) =
  if ocelContainsString
       (objectID, !ocelSeenObjects)
  then
    false
  else
  (
    ocelSeenObjects :=
      objectID :: (!ocelSeenObjects);

    ocelAppendLine
      (
        &quot;object.csv&quot;,
        objectID ^ &quot;;&quot; ^ objectType
      );

    true
  );


(* ---------- Object-type-specific writers ---------- *)

fun ocelRegisterProject
    (projectID : ProjID,
     plannedCount : int) =
  if ocelRegisterObjectBase
       (projectID, &quot;Project&quot;)
  then
    ocelAppendLine
      (
        &quot;object_Project.csv&quot;,
        projectID ^ &quot;;&quot; ^
        OCEL_ZERO_TIME ^ &quot;;;&quot; ^
        Int.toString(plannedCount)
      )
  else
    ();


fun ocelRegisterRequirement
    (requirementID : ReqID) =
  if ocelRegisterObjectBase
       (requirementID, &quot;Requirement&quot;)
  then
    ocelAppendLine
      (
        &quot;object_Requirement.csv&quot;,
        requirementID ^ &quot;;&quot; ^
        OCEL_ZERO_TIME ^ &quot;;&quot;
      )
  else
    ();


