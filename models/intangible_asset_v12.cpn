        <ml id="ID2147413653">fun addBusinessDays
    (
      dayIndex : int,
      days : int
    ) =
  if days &lt;= 0
  then
    dayIndex
  else
    addBusinessDays
      (
        nextBusinessDayIndex(dayIndex + 1),
        days - 1
      );


fun businessDayStartDelay
    (businessDays : int) =
let
  val currentAbsoluteMinute =
    MODEL_START_MINUTE_OF_WEEK
    + currentModelMinute()

  val currentDay =
    currentAbsoluteMinute div MINUTES_PER_DAY

  val currentMinute =
    currentAbsoluteMinute mod MINUTES_PER_DAY

  val alignedDay =
    if isBusinessDayIndex(currentDay)
       andalso
       currentMinute &lt;= WORK_START_MINUTE
    then
      currentDay
    else
      nextBusinessDayIndex(currentDay + 1)

  val targetDay =
    addBusinessDays
      (
        alignedDay,
        businessDays
      )

  val targetAbsoluteMinute =
    targetDay * MINUTES_PER_DAY
    + WORK_START_MINUTE
in
  targetAbsoluteMinute
  - currentAbsoluteMinute
end;
          <layout>fun addBusinessDays
    (
      dayIndex : int,
      days : int
    ) =
  if days &lt;= 0
  then
    dayIndex
  else
    addBusinessDays
      (
        nextBusinessDayIndex(dayIndex + 1),
        days - 1
      );


fun businessDayStartDelay
    (businessDays : int) =
let
  val currentAbsoluteMinute =
    MODEL_START_MINUTE_OF_WEEK
    + currentModelMinute()

  val currentDay =
    currentAbsoluteMinute div MINUTES_PER_DAY

  val currentMinute =
    currentAbsoluteMinute mod MINUTES_PER_DAY

  val alignedDay =
    if isBusinessDayIndex(currentDay)
       andalso
       currentMinute &lt;= WORK_START_MINUTE
    then
      currentDay
    else
      nextBusinessDayIndex(currentDay + 1)

  val targetDay =
    addBusinessDays
      (
        alignedDay,
        businessDays
      )

  val targetAbsoluteMinute =
    targetDay * MINUTES_PER_DAY
    + WORK_START_MINUTE
in
  targetAbsoluteMinute
  - currentAbsoluteMinute
end;</layout>
        </ml>
