                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1"/>
        </time>
        <code id="ID2147394797">
          <posattr x="-1249.500000"
                   y="-266.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">input (project, clock);
output (arrivalOut, nextClock, nextDelay);
action
let
  val sampledNextSource =
    sampleNextDemandSource
      (#source clock)

  val sampledNextDelay =
    sampleDelayForSource
      (sampledNextSource)
in
  (
    {
      source = #source clock,
      pid = #pid project
    },

    {
      seq = #seq clock + 1,
      source = sampledNextSource
    },

    sampledNextDelay
  )
end</text>
