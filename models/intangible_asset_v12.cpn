                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">@+ 0</text>
        </time>
        <code id="ID1169">
          <posattr x="288.000000"
                   y="-443.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">input (rid, pid, aid, category, suppliers,procurementOfficer);
output ();
action
let
  val queriedSuppliers =
    eligibleSuppliers
      (
        category,
        suppliers
      )

  val supplierLinks : (string * string) list =
    List.map
      (
        fn supplier =&gt;
          (
            #sid supplier,
            &quot;queried supplier&quot;
          )
      )
      queriedSuppliers

  val baseLinks : (string * string) list =
    [
      (rid, &quot;requirement&quot;),
      (pid, &quot;project context&quot;),
      (aid, &quot;asset under procurement&quot;),
      (
  #resourceID procurementOfficer,
  &quot;performed by&quot;
)
    ]

  val objectLinks =
    baseLinks ^^ supplierLinks
in
  ocelLogEventAt
    (
      &quot;Obtain Quotations&quot;,
      &quot;ObtainQuotations&quot;,
      ocelTimeAfter(D_OBTAIN_QUOTATIONS),
      &quot;&quot;,
      objectLinks
    )
end</text>
