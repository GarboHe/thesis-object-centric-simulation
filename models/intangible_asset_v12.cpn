        ocelTimeAfter
          (D_REVIEW_ACCOUNTING_VOUCHER),

        &quot;;&quot; ^
        ocelVoucherReviewDecisionText
          (sampledDecision),

        [
          (voucherID, &quot;reviewed voucher&quot;),
          (orderID, &quot;related order&quot;),
          (assetID, &quot;related asset&quot;),
          (invoiceID, &quot;related invoice&quot;),
          (reviewerID, &quot;performed by&quot;)
        ]
      )
in
  sampledDecision
end</text>
