          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">[#seq clock &lt;= #plannedReqCount project]</text>
        </cond>
        <time id="ID2147394796">
          <posattr x="-1005.500000"
                   y="14.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
