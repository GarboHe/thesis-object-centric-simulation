        <ml id="ID2147406404">fun currentModelMinute () =
  case Int.fromString(ModelTime.toString(time())) of
      SOME modelMinute =&gt;
        modelMinute

    | NONE =&gt;
        raise Fail
          &quot;Business calendar error: model time is not an integer&quot;;
          <layout>fun currentModelMinute () =
  case Int.fromString(ModelTime.toString(time())) of
      SOME modelMinute =&gt;
        modelMinute

    | NONE =&gt;
        raise Fail
          &quot;Business calendar error: model time is not an integer&quot;;</layout>
