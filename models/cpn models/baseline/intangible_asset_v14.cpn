        <ml id="ID1000100">fun requirementIDFor (n : int) =
  &quot;R-&quot; ^ Int.toString(n);

fun assetIDFor (n : int) =
  &quot;Asset-&quot; ^ Int.toString(n);

fun categoryFor (n : int) =
  case (n - 1) mod 5 of
      0 =&gt; CategoryA
    | 1 =&gt; CategoryB
    | 2 =&gt; CategoryC
    | 3 =&gt; CategoryD
    | _ =&gt; CategoryE;

fun makeRequirement
    (pidValue : ProjID, n : int) : Requirement =
  (
    requirementIDFor(n),
    pidValue,
    assetIDFor(n)
  );

fun makeAsset (n : int) : Asset =
  (
    assetIDFor(n),
    categoryFor(n)
  );

fun projectCanGenerate
    (p : Project, n : int) =
  n &lt;= #plannedReqCount p;
          <layout>fun requirementIDFor (n : int) =
  &quot;R-&quot; ^ Int.toString(n);

fun assetIDFor (n : int) =
