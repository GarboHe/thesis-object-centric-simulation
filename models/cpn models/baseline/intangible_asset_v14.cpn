        <ml id="ID1000147">fun reviewRequirementAction
      (queuedRequirement, reviewerID) =
let
  val req =
    queuedRequirementValue(queuedRequirement)

  val sampledDecision =
    sampleReviewDecision()

  val (rid0, pid0, aid0) =
    req

  val _ =
    ocelLogEventAt
      (
        &quot;Review Requirement&quot;,
        &quot;ReviewRequirement&quot;,

        ocelTimeAfter(D_REVIEW_REQUIREMENT),

        &quot;;&quot; ^
        ocelReviewDecisionText(sampledDecision),

        [
          (rid0, &quot;reviewed requirement&quot;),
          (pid0, &quot;project context&quot;),
          (aid0, &quot;requested asset&quot;),
          (reviewerID, &quot;performed by&quot;)
        ]
      )
in
  (
    sampledDecision,
    req
  )
end;
