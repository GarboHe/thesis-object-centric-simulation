        <ml id="ID1000093">fun fbool(x) = if uniform(0.0,1.0) &lt; x then true else false;
val P_APPROVED = 0.80;
val P_MODIFY   = 0.15;

fun sampleReviewDecision () =
let
  val x = uniform(0.0, 1.0)
in
  if x &lt; P_APPROVED
  then APPROVED

  else if x &lt; P_APPROVED + P_MODIFY
  then MODIFY

  else REJECTED
end;

fun supplierSupports
    (category : AssetCategory,
     supplier : Supplier) =
  List.exists
    (fn supportedCategory =&gt;
       supportedCategory = category)
    (#capabilities supplier);

fun eligibleSuppliers
    (category : AssetCategory,
     suppliers : SupplierList) =
  List.filter
    (fn supplier =&gt;
       supplierSupports(category, supplier))
    suppliers;

fun makeQuotation
    (rid : ReqID,
     aid : AssetID,
     supplier : Supplier) : Quotation =
{
  qid =
    &quot;Q-&quot; ^ rid ^ &quot;-&quot; ^ #sid supplier,

  rid = rid,
  aid = aid,
  sid = #sid supplier,

  price =
    uniform(80000.0, 120000.0),

  performance =
    uniform(60.0, 100.0)
};

fun makeQuotations
    (rid : ReqID,
     aid : AssetID,
     suppliers : SupplierList) =
  List.map
    (fn supplier =&gt;
       makeQuotation(rid, aid, supplier))
    suppliers;
