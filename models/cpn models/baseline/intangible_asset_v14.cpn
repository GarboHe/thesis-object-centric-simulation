      (
        quote : Quotation,
        contractReviewer : HumanResource
      ) =
let
  val sampledDecision =
    sampleContractDecision()

  val reviewerID =
    #resourceID contractReviewer

  val _ =
    ocelLogEventAt
      (
        &quot;Review Contract&quot;,
        &quot;ReviewContract&quot;,
        ocelTimeAfter(D_REVIEW_CONTRACT),
        &quot;;&quot; ^
        ocelContractDecisionText(sampledDecision),
        [
          (#rid quote, &quot;requirement&quot;),
          (#aid quote, &quot;asset under procurement&quot;),
          (#sid quote, &quot;supplier&quot;),
          (reviewerID, &quot;performed by&quot;)
        ]
      )
in
  sampledDecision
end;
          <layout>fun reviewContractAction
      (
        quote : Quotation,
        contractReviewer : HumanResource
      ) =
let
  val sampledDecision =
