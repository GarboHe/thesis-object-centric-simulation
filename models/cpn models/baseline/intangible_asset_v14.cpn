        <ml id="ID1000137">fun ocelTimestampFromElapsedMinute
    (elapsedMinute : int) =
let
  val elapsedSeconds : LargeInt.int =
    LargeInt.fromInt(elapsedMinute)
    *
    SECONDS_PER_MODEL_UNIT

  val absoluteSeconds : LargeInt.int =
    SIMULATION_START_UNIX
    +
    elapsedSeconds

  val utcDate =
    Date.fromTimeUniv
      (
        Time.fromSeconds
          absoluteSeconds
      )
in
  Date.fmt
    &quot;%Y-%m-%dT%H:%M:%SZ&quot;
    utcDate
end;
          <layout>fun ocelTimestampFromElapsedMinute
    (elapsedMinute : int) =
let
  val elapsedSeconds : LargeInt.int =
    LargeInt.fromInt(elapsedMinute)
    *
    SECONDS_PER_MODEL_UNIT

  val absoluteSeconds : LargeInt.int =
    SIMULATION_START_UNIX
    +
    elapsedSeconds

  val utcDate =
    Date.fromTimeUniv
      (
        Time.fromSeconds
          absoluteSeconds
      )
in
  Date.fmt
    &quot;%Y-%m-%dT%H:%M:%SZ&quot;
    utcDate
end;</layout>
        </ml>
