        (rid, &quot;source requirement&quot;),
        (pid, &quot;project context&quot;),
        (aid, &quot;ordered asset&quot;),
        (supplierID, &quot;selected supplier&quot;),
        (officerID, &quot;performed by&quot;)
      ]
    )
end;
