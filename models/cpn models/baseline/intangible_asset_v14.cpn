          <text tool="CPN Tools"
                version="4.0.1"/>
        </time>
        <code id="ID1000827">
          <posattr x="-401.500000"
                   y="525.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
                    thick="0"
                    type="Solid"/>
          <textattr colour="Black"
                    bold="false"/>
          <text tool="CPN Tools"
                version="4.0.1">input ();
output (projectOut, firstClock, firstDelay);
action
let
  val sampledCount =
    discrete(30, 50)

  val sampledFirstSource =
    sampleNextDemandSource(BACKGROUND)

  val sampledFirstDelay =
    sampleDelayForSource(sampledFirstSource)

  val _ =
    ocelInit()

  (* Register the resource objects after OCEL files are reset. *)
  val _ =
    ocelRegisterInitialResources()

  val _ =
    print
      (
        &quot;Planned requirement count: &quot; ^
        Int.toString(sampledCount) ^
        &quot;\n&quot;
      )

  val _ =
    print
      (
        &quot;First arrival delay: &quot; ^
        Int.toString(sampledFirstDelay) ^
        &quot;\n&quot;
      )
in
  (
    {
      pid = &quot;Proj-A&quot;,
      plannedReqCount = sampledCount
    },

    {
      seq = 1,
      source = sampledFirstSource
    },

    sampledFirstDelay
  )
end</text>
        </code>
        <priority id="ID1000828">
          <posattr x="-812.000000"
                   y="95.000000"/>
          <fillattr colour="White"
                    pattern="Solid"
                    filled="false"/>
          <lineattr colour="Black"
