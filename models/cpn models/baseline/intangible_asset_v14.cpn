      (sid : SupplierID, history : SupplierIDList) =
  List.exists (fn existingSid =&gt; existingSid = sid) history;

fun addSupplier
      (sid : SupplierID, history : SupplierIDList) =
  if hasCooperated(sid, history)
  then history
  else sid :: history;
