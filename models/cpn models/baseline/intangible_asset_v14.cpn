        <ml id="ID1000155">fun postAccountingVoucherGuard
      (
        ord : Order,
        voucher : Voucher,
        inv : Invoice,
        oid : OrderID,
        aid : AssetID,
        asset : Asset
      ) =
let
  val
    (
      orderID,
      _,
      _,
      orderAssetID,
      orderSupplierID,
      _
    ) =
    ord

  val
    (
      _,
      voucherOrderID,
      voucherAssetID,
      voucherInvoiceID
    ) =
    voucher

  val
    (
      invoiceID,
      invoiceOrderID,
      invoiceSupplierID
    ) =
    inv

  val
    (
      assetID,
      _
    ) =
    asset
in
     orderID = oid
  andalso voucherOrderID = oid
  andalso invoiceOrderID = oid
  andalso orderAssetID = aid
  andalso voucherAssetID = aid
  andalso assetID = aid
  andalso voucherInvoiceID = invoiceID
  andalso orderSupplierID = invoiceSupplierID
end;
