        <ml id="ID1000003">fun arrivalDelay () = 1;


(* ====================================================== *)
(* BASELINE DETERMINISTIC DURATIONS                       *)
(* All values are model minutes.                          *)
(* External supplier lead time is represented by delayed  *)
(* business-output tokens. Human-resource tokens are held  *)
(* only for the internal handling parameters below.        *)
(* ====================================================== *)

(* Requirement phase *)

val D_SUBMIT_REQUIREMENT : int = 1;
val D_REVIEW_REQUIREMENT : int = 30;
val D_MODIFY_REQUIREMENT : int = 60;

(* Procurement phase *)

val D_OBTAIN_QUOTATIONS : int =
  7 * WORK_MINUTES_PER_DAY;

(* Active Procurement Officer handling before the process *)
(* waits asynchronously for supplier quotations.          *)
val D_PO_INITIATE_QUOTATIONS : int =
  1 * MINUTES_PER_HOUR;

val D_EVALUATE_QUOTATIONS : int =
  4 * MINUTES_PER_HOUR;

val D_REVIEW_CONTRACT : int =
  4 * MINUTES_PER_HOUR;

val D_MODIFY_CONTRACT : int =
  2 * MINUTES_PER_HOUR;

val D_CREATE_PURCHASE_ORDER : int = 2;
val D_CHECK_CONTRACT_NEED : int = 1;
val D_TERMINATE : int = 1;

(* Delivery and acceptance phase *)

val D_RECEIVE_CONTRACT_DELIVERABLE : int =
  5 * WORK_MINUTES_PER_DAY;

(* Active Procurement Officer handling used to register   *)
(* receipt; the remaining lead time is external waiting.  *)
val D_PO_RECORD_DELIVERABLE : int = 30;

val D_RECEIVE_INVOICE : int =
  2 * MINUTES_PER_HOUR;

val D_BUSINESS_TECHNICAL_ACCEPTANCE : int =
  2 * MINUTES_PER_HOUR;

val D_RECTIFY_AND_REDELIVER : int =
  5 * WORK_MINUTES_PER_DAY;

(* Asset-use phase *)

val D_ASSIGN_ASSET_TO_PROJECT : int = 1;
val D_PUT_ASSET_INTO_USE : int = 2;

(* Accounting phase *)

val D_VERIFY_ACCOUNTING_PREREQUISITES : int = 2;
val D_CONFIRM_ACCOUNTING_DATE : int = 1;
val D_REGISTER_INTANGIBLE_ASSET : int = 2;
val D_CREATE_ACCOUNTING_VOUCHER : int = 2;
val D_REVIEW_ACCOUNTING_VOUCHER : int = 20;
val D_MODIFY_ACCOUNTING_VOUCHER : int = 30;
val D_POST_ACCOUNTING_VOUCHER : int = 2;
