        <ml id="ID1000005">fun isBusinessDayIndex
    (dayIndex : int) =
let
  val weekday =
    dayIndex mod 7
in
  weekday &gt;= 0
  andalso
  weekday &lt;= 4
end;


fun nextBusinessDayIndex
    (dayIndex : int) =
  if isBusinessDayIndex(dayIndex)
  then
    dayIndex
  else
    nextBusinessDayIndex(dayIndex + 1);
          <layout>fun isBusinessDayIndex
    (dayIndex : int) =
let
  val weekday =
    dayIndex mod 7
in
  weekday &gt;= 0
  andalso
  weekday &lt;= 4
end;


fun nextBusinessDayIndex
    (dayIndex : int) =
  if isBusinessDayIndex(dayIndex)
  then
    dayIndex
  else
    nextBusinessDayIndex(dayIndex + 1);</layout>
        </ml>
        <ml id="ID1000006">fun nextBusinessStartAbs
    (absoluteMinute : int) =
let
  val dayIndex =
    absoluteMinute div MINUTES_PER_DAY

  val minuteOfDay =
    absoluteMinute mod MINUTES_PER_DAY

  val startOfDay =
    fn day =&gt;
      day * MINUTES_PER_DAY
      + WORK_START_MINUTE
in
  if not(isBusinessDayIndex(dayIndex))
  then
    startOfDay
      (
        nextBusinessDayIndex(dayIndex)
      )

  else if minuteOfDay &lt; WORK_START_MINUTE
  then
    startOfDay(dayIndex)

  else if minuteOfDay &gt;= WORK_END_MINUTE
  then
    startOfDay
      (
        nextBusinessDayIndex(dayIndex + 1)
      )

  else
    absoluteMinute
end;
          <layout>fun nextBusinessStartAbs
    (absoluteMinute : int) =
let
  val dayIndex =
    absoluteMinute div MINUTES_PER_DAY

  val minuteOfDay =
    absoluteMinute mod MINUTES_PER_DAY

  val startOfDay =
    fn day =&gt;
      day * MINUTES_PER_DAY
      + WORK_START_MINUTE
in
  if not(isBusinessDayIndex(dayIndex))
  then
    startOfDay
      (
        nextBusinessDayIndex(dayIndex)
      )

  else if minuteOfDay &lt; WORK_START_MINUTE
  then
    startOfDay(dayIndex)

  else if minuteOfDay &gt;= WORK_END_MINUTE
  then
    startOfDay
      (
        nextBusinessDayIndex(dayIndex + 1)
      )

  else
    absoluteMinute
end;</layout>
        </ml>
        <ml id="ID1000007">fun addBusinessMinutesAbs
    (
      absoluteMinute : int,
      workMinutes : int
    ) =
  if workMinutes &lt;= 0
  then
    absoluteMinute

  else
  let
    val workingStart =
      nextBusinessStartAbs(absoluteMinute)

    val minuteOfDay =
      workingStart mod MINUTES_PER_DAY

    val availableToday =
      WORK_END_MINUTE - minuteOfDay
  in
    if workMinutes &lt;= availableToday
    then
      workingStart + workMinutes

    else
      addBusinessMinutesAbs
        (
          workingStart + availableToday,
          workMinutes - availableToday
        )
  end;


fun businessElapsedDelay
    (workMinutes : int) =
let
  val currentAbsoluteMinute =
    MODEL_START_MINUTE_OF_WEEK
    + currentModelMinute()

  val completionAbsoluteMinute =
    addBusinessMinutesAbs
      (
        currentAbsoluteMinute,
        workMinutes
      )
in
  completionAbsoluteMinute
  - currentAbsoluteMinute
end;
          <layout>fun addBusinessMinutesAbs
    (
      absoluteMinute : int,
      workMinutes : int
    ) =
  if workMinutes &lt;= 0
  then
    absoluteMinute

  else
  let
    val workingStart =
      nextBusinessStartAbs(absoluteMinute)

    val minuteOfDay =
      workingStart mod MINUTES_PER_DAY

    val availableToday =
      WORK_END_MINUTE - minuteOfDay
  in
    if workMinutes &lt;= availableToday
    then
      workingStart + workMinutes

    else
      addBusinessMinutesAbs
        (
          workingStart + availableToday,
          workMinutes - availableToday
        )
  end;


fun businessElapsedDelay
    (workMinutes : int) =
let
  val currentAbsoluteMinute =
    MODEL_START_MINUTE_OF_WEEK
    + currentModelMinute()

  val completionAbsoluteMinute =
    addBusinessMinutesAbs
      (
        currentAbsoluteMinute,
        workMinutes
      )
in
  completionAbsoluteMinute
  - currentAbsoluteMinute
end;</layout>
