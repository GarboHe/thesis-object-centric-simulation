        <ml id="ID1035260">fun performAcceptanceAction
      (
        oid : OrderID,
        rid : ReqID,
        pid : ProjID,
        aid : AssetID,
        sid : SupplierID,
        acceptanceTeam : HumanResource
      ) =
let
  val sampledDecision =
    sampleAcceptanceDecision()

  val completionTime =
    ocelTimeAfter(D_BUSINESS_TECHNICAL_ACCEPTANCE)

  val acceptanceID =
    &quot;AR-&quot; ^ oid

  val teamID =
    #resourceID acceptanceTeam

  val _ =
    if sampledDecision = ACCEPTANCE_APPROVED
    then
      (
        ocelRegisterAcceptanceRecordAt
          (
            acceptanceID,
            completionTime
          );

        ocelRegisterO2O
          (
            acceptanceID,
            oid,
            &quot;accepts order&quot;
          );

        ocelRegisterO2O
          (
            acceptanceID,
            aid,
            &quot;accepts asset&quot;
          );

        ocelRegisterO2O
          (
            acceptanceID,
            pid,
            &quot;accepted by project&quot;
          )
      )
    else
      ()

  val acceptanceLinks : (string * string) list =
    if sampledDecision = ACCEPTANCE_APPROVED
    then
      [
        (
          acceptanceID,
          &quot;created acceptance record&quot;
        )
      ]
    else
      []

  val baseLinks : (string * string) list =
    [
      (oid, &quot;accepted order&quot;),
      (rid, &quot;source requirement&quot;),
      (pid, &quot;accepting project&quot;),
      (aid, &quot;asset under acceptance&quot;),
      (sid, &quot;supplying supplier&quot;),
      (teamID, &quot;performed by&quot;)
    ]

  val objectLinks =
    baseLinks ^^ acceptanceLinks

  val _ =
    ocelLogEventAt
      (
        &quot;Perform Business And Technical Acceptance&quot;,
        &quot;PerformBusinessAndTechnicalAcceptance&quot;,
        completionTime,
        &quot;;&quot; ^
        ocelAcceptanceDecisionText(sampledDecision),
        objectLinks
      )
in
  sampledDecision
end;
