        <ml id="ID1000149">fun obtainQuotationsAction
      (
        rid : ReqID,
        pid : ProjID,
        aid : AssetID,
        category : AssetCategory,
        suppliers : SupplierList,
        procurementOfficer : HumanResource
      ) =
let
  val queriedSuppliers =
    eligibleSuppliers(category, suppliers)

  val supplierLinks : (string * string) list =
    List.map
      (
        fn (supplier : Supplier) =&gt;
          (
            #sid supplier,
            &quot;queried supplier&quot;
          )
      )
      queriedSuppliers

  val objectLinks : (string * string) list =
    [
      (rid, &quot;requirement&quot;),
      (pid, &quot;project context&quot;),
      (aid, &quot;asset under procurement&quot;),
      (
        #resourceID procurementOfficer,
        &quot;performed by&quot;
      )
    ]
    ^^ supplierLinks
in
  ocelLogEventAt
    (
      &quot;Obtain Quotations&quot;,
      &quot;ObtainQuotations&quot;,
      ocelTimeAfter(D_OBTAIN_QUOTATIONS),
      &quot;&quot;,
      objectLinks
    )
end;
