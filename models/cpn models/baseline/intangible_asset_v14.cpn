        <ml id="ID2075285">fun verifyAccountingPrerequisitesAction
      (
        invid : InvoiceID,
        oid : OrderID,
        sid : SupplierID,
        aid : AssetID,
        rid : ReqID,
        pid : ProjID,
        accid : AcceptanceID,
        assetAccountant : HumanResource
      ) =
let
  val accountantID =
    #resourceID assetAccountant
in
  ocelLogEventAt
    (
      &quot;Verify Accounting Prerequisites&quot;,
      &quot;VerifyAccountingPrerequisites&quot;,
      ocelTimeAfter(D_VERIFY_ACCOUNTING_PREREQUISITES),
      &quot;&quot;,
      [
        (oid, &quot;verified order&quot;),
        (invid, &quot;verified invoice&quot;),
        (accid, &quot;verified acceptance record&quot;),
        (aid, &quot;verified asset&quot;),
        (rid, &quot;source requirement&quot;),
        (pid, &quot;project context&quot;),
        (sid, &quot;supplier&quot;),
        (accountantID, &quot;performed by&quot;)
      ]
    )
end;
