        <ml id="ID1000094">val MinPerformance = 75.0;
fun betterQuotation
    (q1 : Quotation,
     q2 : Quotation) =
  if #performance q1 &gt;= MinPerformance
     andalso #performance q2 &lt; MinPerformance
  then q1

  else if #performance q2 &gt;= MinPerformance
          andalso #performance q1 &lt; MinPerformance
  then q2

  else if #price q1 &lt;= #price q2
  then q1

  else q2;

fun bestQuotation [] =
      raise Fail &quot;No quotation available&quot;

  | bestQuotation (q :: qs) =
      List.foldl
        (fn (candidate, currentBest) =&gt;
           betterQuotation(candidate, currentBest))
        q
        qs;
          <layout>val MinPerformance = 75.0;
fun betterQuotation
    (q1 : Quotation,
     q2 : Quotation) =
  if #performance q1 &gt;= MinPerformance
     andalso #performance q2 &lt; MinPerformance
  then q1

  else if #performance q2 &gt;= MinPerformance
          andalso #performance q1 &lt; MinPerformance
  then q2

  else if #price q1 &lt;= #price q2
  then q1

  else q2;

fun bestQuotation [] =
      raise Fail &quot;No quotation available&quot;

  | bestQuotation (q :: qs) =
      List.foldl
        (fn (candidate, currentBest) =&gt;
           betterQuotation(candidate, currentBest))
        q
        qs;</layout>
