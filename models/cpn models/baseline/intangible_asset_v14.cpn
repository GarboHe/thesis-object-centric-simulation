       )
  then
    ocelAppendLine
      (
        &quot;object_Requirement.csv&quot;,

        requirementID ^ &quot;;&quot; ^
        objectTime ^ &quot;;;&quot; ^
        ocelDemandSourceText(demandSource)
      )
  else
    ();


