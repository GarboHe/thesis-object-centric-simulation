        <ml id="ID1000033">fun requirementSequence
    (requirementID : string) =
  case Int.fromString
         (String.extract(requirementID, 2, NONE)) of
      SOME sequenceNumber =&gt; sequenceNumber
    | NONE =&gt; 1073741823;

fun queuedRequirementBefore
    (left : QueuedRequirement,
     right : QueuedRequirement) =
     #readyAt left &lt; #readyAt right
  orelse
     (#readyAt left = #readyAt right
      andalso
      requirementSequence(#rid left)
      &lt; requirementSequence(#rid right));

fun insertQueuedRequirement
    (entry : QueuedRequirement,
     [] : RequirementReviewQueue) =
      [entry]

  | insertQueuedRequirement
      (entry,
       firstEntry :: remainingEntries) =
      if queuedRequirementBefore(entry, firstEntry)
      then entry :: firstEntry :: remainingEntries
      else
        firstEntry ::
        insertQueuedRequirement
          (entry, remainingEntries);

fun enqueueRequirementForReview
    ((requirementID,
      projectID,
      assetID) : Requirement,
     queue : RequirementReviewQueue) =
  insertQueuedRequirement
    (
      {
        rid = requirementID,
        pid = projectID,
        aid = assetID,
        readyAt = currentModelMinute()
      },
      queue
    );

fun queuedRequirementValue
    (entry : QueuedRequirement) : Requirement =
  (
    #rid entry,
    #pid entry,
    #aid entry
  );
          <layout>(* FIFO queue for Requirement Review.
   Primary key: model time at which the occurrence becomes ready.
   Tie-breaker: ascending Requirement sequence number. *)

fun requirementSequence
    (requirementID : string) =
  case Int.fromString
         (String.extract(requirementID, 2, NONE)) of
      SOME sequenceNumber =&gt; sequenceNumber
    | NONE =&gt; 1073741823;

fun queuedRequirementBefore
    (left : QueuedRequirement,
     right : QueuedRequirement) =
     #readyAt left &lt; #readyAt right
  orelse
     (#readyAt left = #readyAt right
      andalso
      requirementSequence(#rid left)
      &lt; requirementSequence(#rid right));

fun insertQueuedRequirement
    (entry : QueuedRequirement,
     [] : RequirementReviewQueue) =
      [entry]

  | insertQueuedRequirement
      (entry,
       firstEntry :: remainingEntries) =
      if queuedRequirementBefore(entry, firstEntry)
      then entry :: firstEntry :: remainingEntries
      else
        firstEntry ::
        insertQueuedRequirement
          (entry, remainingEntries);

fun enqueueRequirementForReview
    ((requirementID,
      projectID,
      assetID) : Requirement,
     queue : RequirementReviewQueue) =
  insertQueuedRequirement
    (
      {
        rid = requirementID,
        pid = projectID,
        aid = assetID,
        readyAt = currentModelMinute()
      },
      queue
    );

fun queuedRequirementValue
    (entry : QueuedRequirement) : Requirement =
  (
    #rid entry,
    #pid entry,
    #aid entry
  );</layout>
        </ml>
        <ml id="ID1000034">val REQUIREMENT_REVIEW_QUEUE_POLICY =
  &quot;FIFO by readyAt; simultaneous arrivals ordered by Requirement sequence&quot;;

val PROCUREMENT_OFFICER_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val CONTRACT_REVIEWER_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val ACCEPTANCE_TEAM_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val ASSET_ACCOUNTANT_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val VOUCHER_REVIEWER_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val RESOURCE_QUEUE_EXECUTION_MODE =
  &quot;CPN Tools automatic simulation; random enabled-binding selection operationalises SIRO&quot;;

val OCPS_R5_8_QUEUE_POLICY_COVERAGE =
  &quot;All six finite human-resource pools have an explicitly specified queue-ordering rule&quot;;
          <layout>(* ====================================================== *)
(* OCPS-R5.8 RESOURCE QUEUE-ORDERING POLICIES              *)
(*                                                        *)
(* Requirement Reviewer: executable FIFO queue ordered by *)
(* readyAt. Equal readyAt values are ordered by ascending  *)
(* Requirement sequence number for reproducibility.       *)
(*                                                        *)
(* Other finite human-resource pools: SIRO among enabled   *)
(* activity occurrences. SIRO is operationalised by CPN   *)
(* Tools automatic simulation&apos;s random selection of an    *)
(* enabled binding element. Reported runs must therefore   *)
(* be executed in automatic simulation mode.              *)
(* ====================================================== *)

val REQUIREMENT_REVIEW_QUEUE_POLICY =
  &quot;FIFO by readyAt; simultaneous arrivals ordered by Requirement sequence&quot;;

val PROCUREMENT_OFFICER_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val CONTRACT_REVIEWER_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val ACCEPTANCE_TEAM_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val ASSET_ACCOUNTANT_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val VOUCHER_REVIEWER_QUEUE_POLICY =
  &quot;SIRO among enabled activity occurrences&quot;;

val RESOURCE_QUEUE_EXECUTION_MODE =
  &quot;CPN Tools automatic simulation; random enabled-binding selection operationalises SIRO&quot;;

val OCPS_R5_8_QUEUE_POLICY_COVERAGE =
  &quot;All six finite human-resource pools have an explicitly specified queue-ordering rule&quot;;</layout>
