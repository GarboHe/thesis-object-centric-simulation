        <ml id="ID1130778">fun contractHistoryOut
      (
        contractDecision : ContractReviewDecision,
        quote : Quotation,
        history : SupplierIDList
      ) =
  if contractDecision = CONTRACT_APPROVED
  then
    1`addSupplier(#sid quote, history)

  else if contractDecision = CONTRACT_REJECTED
  then
    1`history

  else
    empty;
